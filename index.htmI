
<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>سەوزە و میوە</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,sans-serif;
 background:#f4f8f3;
 color:#222;
}
header{
 background:#2e7d32;
 color:white;
 padding:22px;
 text-align:center;
}
header h1{margin:0;font-size:30px}
header p{margin:8px 0 0}

.container{padding:18px}
.search{
 width:100%;
 padding:14px;
 border:1px solid #ddd;
 border-radius:14px;
 font-size:16px;
 margin-bottom:18px;
}

h2{color:#2e7d32}

.grid{
 display:grid;
 grid-template-columns:repeat(2,1fr);
 gap:14px;
}

.card{
 background:white;
 border-radius:18px;
 padding:15px;
 text-align:center;
 box-shadow:0 3px 12px #0001;
}
.card .emoji{font-size:48px}
.card h3{margin:8px 0}
.price{color:#2e7d32;font-weight:bold}

button{
 background:#2e7d32;
 color:white;
 border:0;
 padding:11px 18px;
 border-radius:12px;
 font-size:15px;
 margin-top:8px;
}

.cart{
 position:fixed;
 bottom:18px;
 left:18px;
 right:18px;
 background:#1b5e20;
 color:white;
 padding:16px;
 border-radius:16px;
 text-align:center;
 font-size:18px;
}

#register{
 background:white;
 margin-top:25px;
 padding:20px;
 border-radius:18px;
 box-shadow:0 3px 12px #0001;
}

input{
 width:100%;
 padding:13px;
 margin:7px 0;
 border:1px solid #ddd;
 border-radius:12px;
}
</style>
</head>

<body>

<header>
<h1>🌱 سەوزە و میوە 🍎</h1>
<p>سەوزە و میوەی تازە، بە ئاسانترین شێوە</p>
</header>

<div class="container">

<input class="search" id="search"
placeholder="گەڕان بۆ سەوزە یان میوە..."
onkeyup="searchProducts()">

<h2>🥬 سەوزەکان</h2>

<div class="grid" id="vegetables">

<div class="card">
<div class="emoji">🥒</div>
<h3>خیار</h3>
<div class="price">1500 د.ع</div>
<button onclick="addCart('خیار')">زیادکردن</button>
</div>

<div class="card">
<div class="emoji">🍅</div>
<h3>تەماطە</h3>
<div class="price">2000 د.ع</div>
<button onclick="addCart('تەماطە')">زیادکردن</button>
</div>

<div class="card">
<div class="emoji">🥕</div>
<h3>گەزەر</h3>
<div class="price">1500 د.ع</div>
<button onclick="addCart('گەزەر')">زیادکردن</button>
</div>

<div class="card">
<div class="emoji">🥬</div>
<h3>کاهو</h3>
<div class="price">1000 د.ع</div>
<button onclick="addCart('کاهو')">زیادکردن</button>
</div>

</div>

<h2>🍎 میوەکان</h2>

<div class="grid" id="fruits">

<div class="card">
<div class="emoji">🍎</div>
<h3>سێو</h3>
<div class="price">3000 د.ع</div>
<button onclick="addCart('سێو')">زیادکردن</button>
</div>

<div class="card">
<div class="emoji">🍌</div>
<h3>مۆز</h3>
<div class="price">2500 د.ع</div>
<button onclick="addCart('مۆز')">زیادکردن</button>
</div>

<div class="card">
<div class="emoji">🍊</div>
<h3>پرتەقاڵ</h3>
<div class="price">2500 د.ع</div>
<button onclick="addCart('پرتەقاڵ')">زیادکردن</button>
</div>

<div class="card">
<div class="emoji">🍇</div>
<h3>ترێ</h3>
<div class="price">4000 د.ع</div>
<button onclick="addCart('ترێ')">زیادکردن</button>
</div>

</div>

<div id="register">
<h2>👤 خۆتۆمارکردن</h2>
<input placeholder="ناوی تەواو">
<input placeholder="ژمارەی مۆبایل" type="tel">
<input placeholder="ناونیشان">
<button onclick="register()">تۆمارکردن</button>
</div>

</div>

<div class="cart" id="cart">
🛒 سەبەتە: 0 دانە
</div>

<script>
let cart=0;

function addCart(product){
 cart++;
 document.getElementById("cart").innerHTML=
 "🛒 سەبەتە: "+cart+" دانە";
 alert(product+" زیادکرا بۆ سەبەتە 🛒");
}

function register(){
 alert("بەخێربێیت 🌱 تۆمارکردن بە سەرکەوتوویی کرا!");
}

function searchProducts(){
 let text=document.getElementById("search").value.toLowerCase();
 let cards=document.querySelectorAll(".card");

 cards.forEach(card=>{
   let name=card.querySelector("h3").innerText.toLowerCase();
   card.style.display=name.includes(text) ? "block" : "none";
 });
}
</script>

</body>
</html>
